{
  "name": "@othmanadi/ableton-mcp",
  "version": "0.0.0",
  "description": "Loophole Bridge: an MCP server built on Ableton's official Extensions SDK.",
  "license": "MIT",
  "author": "Ahmad Othman Ammar Adi (CodingWithAdi)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:artifact": "node scripts/verify-packed-artifact.mjs",
    "build": "tsup"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@othmanadi/loophole-core": "workspace:*",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13"
  }
}
